    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "1.63.0",
    "sharp": "^0.35.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
